# Copy to web/.env.local (gitignored). Secrets are referenced by name in definitions (ADR-0015):
# secretRef { name: openai-api-key } → OPENAI_API_KEY

# LLM providers (model-providers/providers.yaml). Without any key the factory runs on the
# deterministic skill handlers + simulated executor, so the whole loop still works.
# GitHub Copilot (openai-compatible): e.g. COPILOT_TOKEN=$(gh auth token)
COPILOT_TOKEN=
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# GitHub source (sources/sources.yaml → github-issues). Optional for public repos.
GITHUB_TOKEN=

# Jira source (sources/sources.yaml → jira-main): Personal Access Token (deployment: datacenter),
# or API token for connection.email (deployment: cloud)
JIRA_TOKEN=

# Sandbox runtime (ADR-0019; ADR-0080 §10 removed the unsandboxed `host` runtime):
# auto | none | bwrap (local, recommended) | podman | kubernetes | …
# FACTORY_SANDBOX_RUNTIME=bwrap

# Without an LLM/sandbox: allow (default, placeholder output) | wait (runs stay Pending until one is available), ADR-0029
# FACTORY_SIMULATION=wait

# Egress proxy allowlist for the agent `fetch_url` tool (ADR-0080 §7 / SEC-5): comma-separated hosts; a leading `.`
# allows a domain and its subdomains. Empty = deny all.
# FACTORY_EGRESS_ALLOW=docs.example.com,.github.com

# ADR-0062 §3: which controllers this process runs. "all" (default, single process), "web" (no check execution), or
# "worker" (checks only, `npm run worker`). Run web with FACTORY_ROLE=web plus a worker so a web restart never
# interrupts a check.
# FACTORY_ROLE=all

# ADR-0062 §3: live-lease concurrency limits for the check worker (defaults 1 per workspace, 2 total).
# FACTORY_CHECKS_PER_WORKSPACE=1
# FACTORY_CHECKS_TOTAL=2

# MCP server at /api/mcp for local agent harnesses (ADR-0034); disabled when unset. Also used by the `factory`
# ToolServer (tool-servers/). Any long random string, e.g. `openssl rand -hex 24`.
# FACTORY_MCP_TOKEN=

# Bind address for the UI/API. Loopback by default (S0-1): the factory's routes are unauthenticated
# (ADR-0009), so exposing them is a deliberate step behind a reverse proxy that authenticates.
# FACTORY_HOST=127.0.0.1

# Optional overrides
# FACTORY_ROOT=..                 # repo root with agents/, skills/, workflows/, …
# FACTORY_DB=./data/factory.db    # SQLite file
# FACTORY_WORKSPACES_DIR=../.workspaces   # workspace worktrees for bwrap (default: <repo>/.workspaces)
