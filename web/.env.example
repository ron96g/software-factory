# Copy to web/.env.local (gitignored). Secrets are referenced by name in definitions (ADR-0015):
# secretRef { name: openai-api-key } → OPENAI_API_KEY

# LLM providers (model-providers/providers.yaml). Without any key the factory runs on the
# deterministic skill handlers + simulated executor, so the whole loop still works.
# GitHub Copilot (openai-compatible): e.g. COPILOT_TOKEN=$(gh auth token)
COPILOT_TOKEN=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# GitHub source (sources/sources.yaml → github-issues). Optional for public repos.
GITHUB_TOKEN=

# Jira source (sources/sources.yaml → jira-main): Personal Access Token (deployment: datacenter),
# or API token for connection.email (deployment: cloud)
JIRA_TOKEN=

# Sandbox runtime (ADR-0019/0020): auto | none | host (UNSANDBOXED, local only) | podman | kubernetes | …
# FACTORY_SANDBOX_RUNTIME=host

# Without an LLM/sandbox: allow (default, placeholder output) | wait (runs stay Pending until one is available), ADR-0029
# FACTORY_SIMULATION=wait

# MCP server at /api/mcp for local agent harnesses (ADR-0034); disabled when unset. Also used by the `factory`
# ToolServer (tool-servers/). Any long random string, e.g. `openssl rand -hex 24`.
# FACTORY_MCP_TOKEN=

# Optional overrides
# FACTORY_ROOT=..                 # repo root with agents/, skills/, workflows/, …
# FACTORY_DB=./data/factory.db    # SQLite file
# FACTORY_WORKSPACES_DIR=../.workspaces   # host runtime worktrees (default: <repo>/.workspaces)
