{
  "name": "software-factory-web",
  "version": "1.0.0",
  "scripts": {
    "dev": "NODE_USE_ENV_PROXY=1 next dev -H ${FACTORY_HOST:-127.0.0.1}",
    "build": "next build",
    "start": "NODE_USE_ENV_PROXY=1 next start -H ${FACTORY_HOST:-127.0.0.1}",
    "worker": "NODE_USE_ENV_PROXY=1 node scripts/worker.ts",
    "crds:generate": "node scripts/gen-crds.ts",
    "gen:crds": "npm run crds:generate",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:integration": "node --test src/core/factory.test.ts src/core/planning-factory.test.ts src/core/checks-pr.test.ts src/core/v02.test.ts src/core/store/crd-envtest.test.ts",
    "test:acceptance": "ls src/acceptance/*.acceptance.test.ts >/dev/null && node --test \"src/acceptance/*.acceptance.test.ts\""
  },
  "type": "module",
  "dependencies": {
    "@kubernetes/client-node": "^2.0.2",
    "@mantine/charts": "^9.8.0",
    "@mantine/core": "^9.8.0",
    "@mantine/hooks": "^9.8.0",
    "@mantine/notifications": "^9.8.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@opencode/plugin": "2.3.0",
    "@opencode/sdk": "2.3.0",
    "@tabler/icons-react": "^3.51.0",
    "ajv": "^8.17.1",
    "mermaid": "^12.3.0",
    "next": "^16.4.6",
    "prom-client": "^15.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.11.1",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "postcss": "^8.5.32",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "^7.0.2",
    "typescript-api": "npm:typescript@5.9.3"
  },
  "private": true
}
