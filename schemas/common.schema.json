{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "factory.ai-dlc.io/v1alpha1" },
    "kind": { "enum": ["Agent", "Skill", "Workflow", "ArtifactType", "Source", "Repository", "ModelProvider", "SandboxProfile", "KnowledgeSource", "ToolServer", "WorkItem", "CheckRun", "RetrospectiveFeedback"] },
    "metadata": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
        "labels": { "type": "object" },
        "annotations": { "type": "object" }
      }
    },
    "spec": { "type": "object" }
  }
}
